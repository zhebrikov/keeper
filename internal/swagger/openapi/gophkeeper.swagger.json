{
  "swagger": "2.0",
  "info": {
    "title": "GophKeeper API",
    "description": "Secure password manager with client-side encryption.",
    "version": "1.0"
  },
  "tags": [
    {
      "name": "GophKeeper"
    }
  ],
  "schemes": [
    "http",
    "https"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "summary": "Login authenticates an existing user.",
        "operationId": "GophKeeper_Login",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1AuthResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1LoginRequest"
            }
          }
        ],
        "tags": [
          "GophKeeper"
        ]
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "summary": "RefreshToken issues a new access token using a refresh token.",
        "operationId": "GophKeeper_RefreshToken",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1AuthResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1RefreshTokenRequest"
            }
          }
        ],
        "tags": [
          "GophKeeper"
        ]
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "summary": "Register creates a new user account.",
        "operationId": "GophKeeper_Register",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1AuthResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1RegisterRequest"
            }
          }
        ],
        "tags": [
          "GophKeeper"
        ]
      }
    },
    "/api/v1/secrets": {
      "get": {
        "summary": "ListSecrets returns secrets optionally filtered by update time.",
        "operationId": "GophKeeper_ListSecrets",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListSecretsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "updatedSince",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "int64"
          }
        ],
        "tags": [
          "GophKeeper"
        ],
        "security": [
          {
            "Bearer": []
          }
        ]
      },
      "post": {
        "summary": "CreateSecret stores a new encrypted secret.",
        "operationId": "GophKeeper_CreateSecret",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1SecretResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1CreateSecretRequest"
            }
          }
        ],
        "tags": [
          "GophKeeper"
        ],
        "security": [
          {
            "Bearer": []
          }
        ]
      }
    },
    "/api/v1/secrets/{id}": {
      "get": {
        "summary": "GetSecret returns a single secret by ID.",
        "operationId": "GophKeeper_GetSecret",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1SecretResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "GophKeeper"
        ],
        "security": [
          {
            "Bearer": []
          }
        ]
      },
      "delete": {
        "summary": "DeleteSecret marks a secret as deleted.",
        "operationId": "GophKeeper_DeleteSecret",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1DeleteSecretResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "GophKeeper"
        ],
        "security": [
          {
            "Bearer": []
          }
        ]
      },
      "put": {
        "summary": "UpdateSecret updates an existing secret with optimistic locking.",
        "operationId": "GophKeeper_UpdateSecret",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1SecretResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/GophKeeperUpdateSecretBody"
            }
          }
        ],
        "tags": [
          "GophKeeper"
        ],
        "security": [
          {
            "Bearer": []
          }
        ]
      }
    },
    "/api/v1/sync": {
      "post": {
        "summary": "Sync returns all secrets changed since the given timestamp.",
        "operationId": "GophKeeper_Sync",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1SyncResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1SyncRequest"
            }
          }
        ],
        "tags": [
          "GophKeeper"
        ],
        "security": [
          {
            "Bearer": []
          }
        ]
      }
    }
  },
  "definitions": {
    "GophKeeperUpdateSecretBody": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "encryptedData": {
          "type": "string",
          "format": "byte"
        },
        "metadata": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "format": "int64"
        }
      }
    },
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "v1AuthResponse": {
      "type": "object",
      "properties": {
        "accessToken": {
          "type": "string"
        },
        "refreshToken": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        }
      }
    },
    "v1CreateSecretRequest": {
      "type": "object",
      "properties": {
        "type": {
          "$ref": "#/definitions/v1SecretType"
        },
        "name": {
          "type": "string"
        },
        "encryptedData": {
          "type": "string",
          "format": "byte"
        },
        "metadata": {
          "type": "string"
        }
      }
    },
    "v1DeleteSecretResponse": {
      "type": "object"
    },
    "v1ListSecretsResponse": {
      "type": "object",
      "properties": {
        "secrets": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1SecretResponse"
          }
        }
      }
    },
    "v1LoginRequest": {
      "type": "object",
      "properties": {
        "login": {
          "type": "string"
        },
        "password": {
          "type": "string"
        }
      }
    },
    "v1RefreshTokenRequest": {
      "type": "object",
      "properties": {
        "refreshToken": {
          "type": "string"
        }
      }
    },
    "v1RegisterRequest": {
      "type": "object",
      "properties": {
        "login": {
          "type": "string"
        },
        "password": {
          "type": "string"
        }
      }
    },
    "v1SecretResponse": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "$ref": "#/definitions/v1SecretType"
        },
        "name": {
          "type": "string"
        },
        "encryptedData": {
          "type": "string",
          "format": "byte"
        },
        "metadata": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "format": "int64"
        },
        "createdAt": {
          "type": "string",
          "format": "int64"
        },
        "updatedAt": {
          "type": "string",
          "format": "int64"
        },
        "deleted": {
          "type": "boolean"
        }
      }
    },
    "v1SecretType": {
      "type": "string",
      "enum": [
        "SECRET_TYPE_UNSPECIFIED",
        "SECRET_TYPE_CREDENTIAL",
        "SECRET_TYPE_TEXT",
        "SECRET_TYPE_BINARY",
        "SECRET_TYPE_CARD",
        "SECRET_TYPE_OTP"
      ],
      "default": "SECRET_TYPE_UNSPECIFIED",
      "description": "SecretType identifies the kind of stored data."
    },
    "v1SyncRequest": {
      "type": "object",
      "properties": {
        "lastSyncAt": {
          "type": "string",
          "format": "int64"
        }
      }
    },
    "v1SyncResponse": {
      "type": "object",
      "properties": {
        "secrets": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1SecretResponse"
          }
        },
        "syncAt": {
          "type": "string",
          "format": "int64"
        }
      }
    }
  },
  "securityDefinitions": {
    "Bearer": {
      "type": "apiKey",
      "description": "JWT access token. Format: Bearer {token}",
      "name": "Authorization",
      "in": "header"
    }
  }
}
